{
  "name": "dsh-snowluma-companion",
  "version": "1.3.0",
  "description": "SnowLuma 陪伴助手：QQ 接入、人格、记忆、主动聊天与备份的一体化 dsh 插件。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "onebot",
    "onebot11",
    "snowluma",
    "qq",
    "astrbot"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "Geng-zy",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "files": [
    "lib",
    "dsh.plugin.json",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "deploy/snowluma.compose.yml",
    "deploy/snowluma.env.example",
    "deploy/migrate-profile.mjs",
    "install.sh",
    "deploy/install.py"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.json && node scripts/build-client.mjs",
    "test": "node --test test/*.test.mjs test/companion/*.test.mjs",
    "e2e": "node test/e2e.mjs && node test/companion/e2e.mjs",
    "setup-test-env": "scripts/setup-test-env.sh",
    "check": "scripts/check.sh",
    "update-qface": "node scripts/update-qface.mjs"
  },
  "dependencies": {
    "nodemailer": "^10.2.1",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": ">=0.2.0-0 <0.2.1-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.2.3-0 || >=0.2.3-0 <0.2.4-0 || >=0.2.4-0 <0.2.5-0 || >=0.2.5-0 <0.2.6-0 || >=0.2.6-0 <0.2.7-0 || >=0.2.7-0 <0.2.8-0 || >=0.2.8-0 <0.2.9-0 || >=0.2.9-0 <0.3.0-0",
